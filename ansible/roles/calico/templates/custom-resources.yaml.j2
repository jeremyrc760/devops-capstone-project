---
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    bgp: Disabled
    ipPools:
      - blockSize: 26
        cidr: {{ calico_pod_network_cidr | quote }}
        encapsulation: {{ calico_encapsulation }}
        natOutgoing: {{ calico_nat_outgoing }}
        nodeSelector: {{ calico_node_selector | quote }}
{% if calico_enable_api_server | bool %}
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
{% endif %}
